# Copy this file to .env and fill in the values you need.
# Everything except the sign-in settings has a sensible default.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Leave empty to run with the in-memory store (demo only, data is lost on exit).
MONGO_URI=mongodb://127.0.0.1:27017/ethio-lost-and-found
# Set this to empty to use the in-memory store:
# MONGO_URI=
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- Department access (/admin) ---
# Staff sign in with an email and password at /admin. These values create the
# FIRST manager account when the database has no accounts yet.
ADMIN_EMAIL=manager@depot.et
ADMIN_PASSWORD=change-me-before-going-live
ADMIN_NAME=Merkato manager
ADMIN_DEPOT=Merkato

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# How long a sign-in lasts, in hours.
SESSION_HOURS=12

# Further accounts are created from the Accounts tab at /admin, or with:
#   npm run create-staff -- --email name@depot.et --name "Full name" --password "…" 

# --- Item policy ---
# Days an item is kept before it is disposed of (default 90).
RETENTION_DAYS=90
# Add demo items to an empty database on first boot.
SEED_DEMO_DATA=true

# --- Image storage ---
# Leave the Cloudinary values empty to store uploads on local disk
# (served from /uploads). Set all three to use Cloudinary instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# UPLOAD_DIR=./uploads

# --- CORS ---
# Comma separated list of browser origins allowed to call the API.
# "*" (the default in development) allows any origin.
# CORS_ORIGIN=http://localhost:5173
