# Copy this file to .env and fill in the values you need.
# Everything except MONGO_URI has a sensible development default.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/ethio-lost-and-found
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- Image storage ---
# Leave the Cloudinary values empty to store uploads on local disk
# (served from /uploads). Set all three to use Cloudinary instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# UPLOAD_DIR=./uploads

# --- CORS ---
# Comma separated list of browser origins allowed to call the API.
# "*" (the default in development) allows any origin.
# CORS_ORIGIN=http://localhost:5173
